#!/bin/bash
# 从远程服务器下载文件/目录。
set -eu

usage() {
  cat <<HELP
Usage: ${0##*/} SERVER_ALIAS REMOTE_PATH LOCAL_PATH

Download files/directories from a remote server.
  -h, --help  show this help message
HELP
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  usage
  exit 0
fi
if (( $# != 3 )) || [[ -z $1 || -z $2 || -z $3 ]]; then
  usage >&2
  exit 1
fi

rsync -avuP --human-readable "${1}:${2}" "$3"
printf '\nDownload completed.\n'
