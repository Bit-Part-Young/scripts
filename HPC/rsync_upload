#!/bin/bash
# 将文件/目录上传到远程服务器。
set -eu

usage() {
  cat <<HELP
Usage: ${0##*/} SERVER_ALIAS [--exclude PATTERN]... FILES... TARGET_PATH

Upload files/directories to a remote server.
  --exclude PATTERN  exclude matching files (repeatable)
  -h, --help         show this help message
HELP
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  usage
  exit 0
fi

server=${1:-}
shift || true
exclude_opts=()
while [[ ${1:-} == --exclude ]]; do
  [[ $# -ge 2 ]] || { echo "Error: --exclude requires a pattern." >&2; exit 1; }
  exclude_opts+=(--exclude="$2")
  shift 2
done

if [[ -z $server || $# -lt 2 ]]; then
  usage >&2
  exit 1
fi

target=${!#}
rsync -avuP --human-readable ${exclude_opts[@]+"${exclude_opts[@]}"} "${@:1:$#-1}" "${server}:${target}"
printf '\nUpload completed.\n'
