#!/bin/bash
# 检查 VASP 计算目录是否计算完成（OUTCAR 中出现 "Total CPU time used"）

set -eu

usage() {
  local s; s=$(basename "$0")
  cat <<EOT

Usage: $s [dirs...]

Check VASP calculation dirs whether completed.

Options:
  -h, --help    show this help message and exit
  dirs          VASP calculation dirs ("." = all sub-dirs of current dir)

Examples:
    $s \${PWD}       # 当前目录
    $s test1        # 单个目录
    $s test1 test2  # 多个目录
    $s .            # 当前目录下的所有子目录
EOT
}

# 显示名：相对路径原样；绝对路径（去掉 $PWD 前缀后）取最后 3 级
short_name() {
  local d=${1#./}
  if [[ $d != /* ]]; then echo "$d"
  elif [[ $d == "$PWD" ]]; then basename "$d"
  else d=${d#"$PWD"/}; echo "$d" | awk -F/ '{print (NF > 3 ? $(NF-2)"/"$(NF-1)"/"$NF : $0)}'
  fi
}

# 打印分组：$1 标题，其余为条目（为空则不打印）
print_group() {
  local title=$1; shift
  [[ $# -eq 0 ]] && return 0
  echo "${title} ($#):"
  printf "  %s\n" "$@"
  echo
}

check() {
  local dir name completed=() uncompleted=() no_outcar=()
  for dir in "$@"; do
    name=$(short_name "$dir")
    if [[ ! -f $dir/OUTCAR ]]; then no_outcar+=("$name")
    elif grep -q "Total CPU time used" "$dir/OUTCAR"; then completed+=("$name")
    else uncompleted+=("$name")
    fi
  done

  print_group "Completed dirs" "${completed[@]}"
  print_group "Uncompleted dirs" "${uncompleted[@]}"
  print_group "Dirs without OUTCAR" "${no_outcar[@]}"
  [[ $# -gt 0 && ${#uncompleted[@]} -eq 0 && ${#no_outcar[@]} -eq 0 ]] && echo "All VASP calculation dirs are completed!"
  return 0
}


#-------------------------------- 主函数 --------------------------------
if [[ $# -eq 0 || $1 == "-h" || $1 == "--help" ]]; then
  usage; exit 0
fi
[[ $# -eq 1 && $1 == "." ]] && set -- ./*/

mapfile -t dirs < <(for d in "$@"; do [[ -d $d ]] && printf "%s\n" "${d%/}"; done | sort -V)
check "${dirs[@]}"
