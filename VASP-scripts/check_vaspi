#!/bin/bash

# 检查 VASP 输入文件是否 OK


# 检查必需的输入文件是否存在
function files_check(){
  local missing=0
  for f in INCAR POSCAR POTCAR; do
    [[ -f ${f} ]] || { echo "${f} is not found!"; echo; missing=1; }
  done
  return ${missing}
}


# 检查 INCAR 文件中的 KSPACING 参数和 KPOINTS 文件（二者只能有一个）
function incar_kpoints_check(){
  local kspacing=0
  grep -qiE '^[[:space:]]*KSPACING[[:space:]]*=' INCAR && kspacing=1

  if [[ ! -f KPOINTS && ${kspacing} -eq 0 ]]; then
    echo "KPOINTS and INCAR KSPACING param are not found!"
    echo
    return 1
  elif [[ -f KPOINTS && ${kspacing} -eq 1 ]]; then
    echo "Both KPOINTS and INCAR KSPACING param are found! Just keep one of both!"
    echo
    return 1
  fi
  return 0
}


# 检查 POSCAR 文件中第 7 行的原子数和实际原子坐标行数是否一致
function poscar_check(){
  local natoms1 natoms2
  natoms1=$(awk 'NR==7 {for(i=1; i<=NF; i++) a+=$i; print a+0}' POSCAR)
  # 当原子位置信息行后面出现空行时，停止统计（兼容 Selective dynamics）
  natoms2=$(awk 'NR>=9 {if(NF==0) exit; if(NF>=3) count++} END {print count+0}' POSCAR)

  if [[ ${natoms1} -ne ${natoms2} ]]; then
    echo "natoms of 7th line($natoms1) and number of atoms coordinates in POSCAR($natoms2) are not consistent!"
    echo
    return 1
  fi
  return 0
}


# 检查 POSCAR 中的元素和 POTCAR 中的赝势（VRHFIN 字段的元素）是否一一对应
function psp_check(){
  local elements psps
  # POSCAR 第 6 行可能是 'Ti_sv/abc123' 形式，只保留元素符号
  elements=$(awk 'NR==6 {for(i=1; i<=NF; i++) {split($i, a, /[_\/]/); printf "%s ", a[1]}}' POSCAR)
  psps=$(awk -F'[=:]' '/VRHFIN/ {gsub(/[ \t]/, "", $2); printf "%s ", $2}' POTCAR)

  if [[ ${elements} != "${psps}" ]]; then
    echo "Elements in POSCAR(${elements% }) and POTCAR(${psps% }) do not match!"
    echo
    return 1
  fi
  return 0
}


# 检查 job.slurm 中的队列是否存在、module load 是否与平台匹配
function slurm_check(){
  if [[ ! -f job.slurm ]]; then
    echo "job.slurm is not found! Please make sure whether you need it!"
    echo
    return 1
  fi

  local platform partition modules need_modules=0
  platform=$(hostname -f 2>/dev/null || hostname)
  partition=$(awk '/^#SBATCH/ {for(i=2; i<=NF; i++) {
      if ($i == "-p" || $i == "--partition") print $(i+1)
      else if ($i ~ /^--partition=/) {sub(/^--partition=/, "", $i); print $i}
      else if ($i ~ /^-p./) print substr($i, 3)}}' job.slurm | tail -1)
  modules=$(grep -c '^[[:space:]]*module load ' job.slurm || true)
  # 交大超算（思源/π）需要 module load，课题组服务器不需要
  [[ ${platform} == *sjtu* || -d /dssg || -d /lustre ]] && need_modules=1

  if [[ -z ${partition} ]]; then
    echo "No partition (-p/--partition) found in job.slurm!"
    echo
    return 1
  fi
  if command -v sinfo >/dev/null && ! sinfo -h -o '%P' | tr -d '*' | grep -qx "${partition}"; then
    echo "Partition(${partition}) does not exist on ${platform}!"
    echo
    return 1
  fi
  if (( need_modules == 1 && modules == 0 )) || (( need_modules == 0 && modules > 0 )); then
    echo "Platform(${platform}) and 'module load' lines(${modules}) of job.slurm do not match! Please check carefully!"
    echo
    return 1
  fi
  return 0
}


#-------------------------------- 获取帮助 --------------------------------
get_help() {
  echo -e "\nUsage: $(basename "${0}")"
  echo -e "\nCheck VASP input files (INCAR/KPOINTS, POSCAR, POTCAR, job.slurm) in the current directory."
  echo -e "\nOptions:"
  echo "    -h, --help       show this help message and exit"
  echo -e "\nAuthor: SLY."
}


#-------------------------------- 主函数 --------------------------------
if [[ $1 == "-h" || $1 == "--help" ]]; then
  get_help
  exit 0
elif [[ $# -gt 0 ]]; then
  get_help
  exit 1
fi

status=0
if files_check; then
  incar_kpoints_check || status=1
  poscar_check || status=1
  psp_check || status=1
else
  status=1
fi
slurm_check || status=1

if [[ ${status} -eq 0 ]]; then
  echo "VASP input files are OK. Happy to run!"
else
  echo "VASP input files are not OK. Please check carefully!"
fi
exit ${status}
